{
  "name": "grass contact, swimming foam and wakes, frozen visuals and replay",
  "steps": [
    {
      "command": {
        "op": "reset"
      },
      "save_as": "initial",
      "capture": "start.png"
    },
    {
      "command": {
        "op": "step",
        "frames": 220,
        "keys": [
          "W",
          "A"
        ]
      },
      "save_as": "grass",
      "capture": "grass.png"
    },
    {
      "command": {
        "op": "step",
        "frames": 180,
        "keys": [
          "A",
          "S"
        ]
      },
      "save_as": "entry",
      "capture": "entry.png"
    },
    {
      "command": {
        "op": "step",
        "frames": 60,
        "keys": [
          "A",
          "S"
        ]
      },
      "save_as": "swimming",
      "capture": "swimming.png"
    },
    {
      "command": {
        "op": "observe"
      },
      "save_as": "frozen",
      "wait_seconds": 0.5
    },
    {
      "command": {
        "op": "step",
        "frames": 120
      },
      "save_as": "calm",
      "capture": "calm.png"
    },
    {
      "command": {
        "op": "reset"
      },
      "save_as": "reset"
    },
    {
      "command": {
        "op": "step",
        "frames": 220,
        "keys": [
          "W",
          "A"
        ]
      }
    },
    {
      "command": {
        "op": "step",
        "frames": 180,
        "keys": [
          "A",
          "S"
        ]
      }
    },
    {
      "command": {
        "op": "step",
        "frames": 60,
        "keys": [
          "A",
          "S"
        ]
      },
      "save_as": "replayed",
      "capture": "replayed.png"
    }
  ],
  "assertions": [
    {
      "kind": "field",
      "first": "swimming",
      "path": [
        "players",
        0,
        "body",
        "swimming"
      ],
      "value": true
    },
    {
      "kind": "equal_state",
      "first": "swimming",
      "second": "frozen"
    },
    {
      "kind": "equal_state",
      "first": "swimming",
      "second": "replayed"
    },
    {
      "kind": "equal_state",
      "first": "initial",
      "second": "reset"
    },
    {
      "kind": "positive_field",
      "first": "grass",
      "path": [
        "visual",
        "grass_contacts"
      ]
    },
    {
      "kind": "positive_field",
      "first": "grass",
      "path": [
        "visual",
        "grass_trails"
      ]
    },
    {
      "kind": "positive_field",
      "first": "swimming",
      "path": [
        "visual",
        "water_contacts"
      ]
    },
    {
      "kind": "positive_field",
      "first": "swimming",
      "path": [
        "visual",
        "wakes"
      ]
    }
  ],
  "image_assertions": [
    {
      "first": "swimming.png",
      "second": "replayed.png"
    }
  ]
}
