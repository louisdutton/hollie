{
  "name": "pause, editor paint and undo, frozen state, discard and reset",
  "steps": [
    {
      "command": {
        "op": "step",
        "frames": 1,
        "keys": [
          "ENTER"
        ]
      },
      "save_as": "started",
      "capture": "olivewood.png"
    },
    {
      "command": {
        "op": "reset"
      },
      "save_as": "initial"
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "keys": [
          "P"
        ]
      },
      "save_as": "paused",
      "capture": "paused.png"
    },
    {
      "command": {
        "op": "step",
        "frames": 30,
        "keys": [
          "D"
        ]
      },
      "save_as": "still_paused"
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "keys": [
          "ENTER"
        ]
      },
      "save_as": "resumed"
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "keys": [
          "F1"
        ]
      },
      "save_as": "editor",
      "capture": "editor.png"
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "keys": [
          "RIGHT"
        ]
      }
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "keys": [
          "SPACE"
        ]
      },
      "save_as": "painted",
      "capture": "painted.png"
    },
    {
      "wait_seconds": 0.5,
      "command": {
        "op": "observe"
      },
      "save_as": "idle"
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "keys": [
          "LEFT_CONTROL",
          "Z"
        ]
      },
      "save_as": "undone"
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "keys": [
          "F1"
        ]
      },
      "save_as": "exit"
    },
    {
      "command": {
        "op": "reset"
      },
      "save_as": "reset"
    }
  ],
  "assertions": [
    {
      "kind": "field",
      "first": "paused",
      "path": [
        "scene"
      ],
      "value": "Paused"
    },
    {
      "kind": "field",
      "first": "still_paused",
      "path": [
        "scene"
      ],
      "value": "Paused"
    },
    {
      "kind": "field",
      "first": "resumed",
      "path": [
        "scene"
      ],
      "value": "Gameplay"
    },
    {
      "kind": "field",
      "first": "editor",
      "path": [
        "scene"
      ],
      "value": "Editor"
    },
    {
      "kind": "field",
      "first": "exit",
      "path": [
        "scene"
      ],
      "value": "Gameplay"
    },
    {
      "kind": "field",
      "first": "painted",
      "path": [
        "editor",
        "dirty"
      ],
      "value": true
    },
    {
      "kind": "equal_state",
      "first": "painted",
      "second": "idle"
    },
    {
      "kind": "equal_state",
      "first": "initial",
      "second": "reset"
    },
    {
      "kind": "equal_field",
      "first": "paused",
      "second": "still_paused",
      "path": [
        "players"
      ]
    },
    {
      "kind": "equal_field",
      "first": "editor",
      "second": "undone",
      "path": [
        "editor",
        "base"
      ]
    },
    {
      "kind": "field",
      "first": "started",
      "path": [
        "scene"
      ],
      "value": "Gameplay"
    },
    {
      "kind": "field",
      "first": "started",
      "path": [
        "room"
      ],
      "value": "olivewood"
    }
  ]
}
