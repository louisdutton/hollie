{
  "name": "right-stick collider overlay, held-input edges, keyboard fallback and reset",
  "steps": [
    {
      "command": {
        "op": "reset"
      },
      "save_as": "off",
      "capture": "off.png"
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "gamepads": [
          {
            "player": "Player_1",
            "buttons": [
              "RIGHT_THUMB"
            ]
          }
        ]
      },
      "save_as": "on",
      "capture": "on.png"
    },
    {
      "command": {
        "op": "observe"
      },
      "save_as": "frozen",
      "capture": "frozen.png"
    },
    {
      "command": {
        "op": "step",
        "frames": 4,
        "gamepads": [
          {
            "player": "Player_1",
            "buttons": [
              "RIGHT_THUMB"
            ]
          }
        ]
      },
      "save_as": "held"
    },
    {
      "command": {
        "op": "step",
        "frames": 1
      }
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "gamepads": [
          {
            "player": "Player_1",
            "buttons": [
              "RIGHT_THUMB"
            ]
          }
        ]
      },
      "save_as": "off_again",
      "capture": "off-again.png"
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "keys": [
          "F3"
        ]
      },
      "save_as": "keyboard",
      "capture": "keyboard.png"
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "keys": [
          "F1"
        ]
      },
      "save_as": "editor"
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "keys": [
          "F3"
        ]
      },
      "save_as": "still_editor"
    },
    {
      "command": {
        "op": "reset"
      },
      "save_as": "reset",
      "capture": "reset.png"
    }
  ],
  "assertions": [
    {
      "kind": "field",
      "first": "off",
      "path": [
        "debug",
        "enabled"
      ],
      "value": false
    },
    {
      "kind": "field",
      "first": "on",
      "path": [
        "debug",
        "enabled"
      ],
      "value": true
    },
    {
      "kind": "field",
      "first": "held",
      "path": [
        "debug",
        "enabled"
      ],
      "value": true
    },
    {
      "kind": "field",
      "first": "off_again",
      "path": [
        "debug",
        "enabled"
      ],
      "value": false
    },
    {
      "kind": "field",
      "first": "keyboard",
      "path": [
        "debug",
        "enabled"
      ],
      "value": true
    },
    {
      "kind": "field",
      "first": "reset",
      "path": [
        "debug",
        "enabled"
      ],
      "value": false
    },
    {
      "kind": "positive_field",
      "first": "on",
      "path": [
        "debug",
        "colliders"
      ]
    },
    {
      "kind": "field",
      "first": "off_again",
      "path": [
        "debug",
        "colliders"
      ],
      "value": 0
    },
    {
      "kind": "field",
      "first": "still_editor",
      "path": [
        "debug",
        "colliders"
      ],
      "value": 0
    },
    {
      "kind": "equal_field",
      "first": "editor",
      "second": "still_editor",
      "path": [
        "debug",
        "enabled"
      ]
    },
    {
      "kind": "equal_state",
      "first": "on",
      "second": "frozen"
    },
    {
      "kind": "equal_state",
      "first": "off",
      "second": "reset"
    }
  ],
  "image_assertions": [
    {
      "first": "on.png",
      "second": "frozen.png"
    },
    {
      "first": "off.png",
      "second": "reset.png"
    }
  ]
}
