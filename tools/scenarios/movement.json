{
  "name": "move, freeze, reset, and replay",
  "steps": [
    {"command": {"op": "reset", "room": "demo", "players": 1, "seed": 42}, "save_as": "initial", "capture": "initial.png"},
    {"wait_seconds": 0.5, "command": {"op": "observe"}, "save_as": "idle"},
    {"command": {"op": "step", "frames": 30, "keys": ["S"]}, "save_as": "moved", "capture": "moved.png"},
    {"wait_seconds": 0.5, "command": {"op": "observe"}, "save_as": "held_idle"},
    {"command": {"op": "step", "frames": 0}, "expect_error": "frames must be between 1 and 600"},
    {"command": {"op": "reset", "room": "does_not_exist"}, "expect_error": "unknown room"},
    {"command": {"op": "observe"}, "save_as": "after_errors"},
    {"command": {"op": "reset", "room": "demo", "players": 1, "seed": 42}, "save_as": "reset"},
    {"command": {"op": "step", "frames": 30, "keys": ["S"]}, "save_as": "replayed", "capture": "replayed.png"}
  ],
  "assertions": [
    {"kind": "equal_state", "first": "initial", "second": "idle"},
    {"kind": "equal_state", "first": "moved", "second": "held_idle"},
    {"kind": "equal_state", "first": "moved", "second": "after_errors"},
    {"kind": "equal_state", "first": "initial", "second": "reset"},
    {"kind": "equal_state", "first": "moved", "second": "replayed"},
    {"kind": "player_moved", "first": "initial", "second": "moved"},
    {"kind": "frame_delta", "first": "initial", "second": "moved", "frames": 30}
  ],
  "image_assertions": [{"first": "moved.png", "second": "replayed.png"}]
}
