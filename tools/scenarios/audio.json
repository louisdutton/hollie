{
  "name": "title birdsong and demo wind layered playback, pause and room transitions",
  "steps": [
    {
      "command": {
        "op": "observe"
      },
      "save_as": "title"
    },
    {
      "command": {
        "op": "reset"
      },
      "save_as": "demo"
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "keys": [
          "P"
        ]
      },
      "save_as": "paused"
    },
    {
      "command": {
        "op": "step",
        "frames": 1
      }
    },
    {
      "command": {
        "op": "step",
        "frames": 1,
        "keys": [
          "ENTER"
        ]
      }
    },
    {
      "command": {
        "op": "step",
        "frames": 8,
        "keys": [
          "W",
          "D"
        ]
      }
    },
    {
      "command": {
        "op": "step",
        "frames": 45
      },
      "save_as": "inside"
    },
    {
      "command": {
        "op": "step",
        "frames": 1
      }
    },
    {
      "command": {
        "op": "step",
        "frames": 8,
        "keys": [
          "A",
          "S"
        ]
      }
    },
    {
      "command": {
        "op": "step",
        "frames": 45
      },
      "save_as": "returned"
    }
  ],
  "assertions": [
    {
      "kind": "field",
      "first": "title",
      "path": [
        "audio"
      ],
      "value": {
        "Music": {
          "path": "audio/A-Feather-Falls-Ian-Aisling-stream-preview.mp3",
          "playing": true
        },
        "Ambience": {
          "path": "audio/Birdsong-River-Flow-Early-Morning-Woodland-stream-preview.mp3",
          "playing": true
        }
      }
    },
    {
      "kind": "field",
      "first": "demo",
      "path": [
        "audio"
      ],
      "value": {
        "Music": {
          "path": "audio/A-Legend-Ian-Aisling-stream-preview.mp3",
          "playing": true
        },
        "Ambience": {
          "path": "audio/Wind-Ambience-Distant-City-stream-preview.mp3",
          "playing": true
        }
      }
    },
    {
      "kind": "field",
      "first": "paused",
      "path": [
        "audio"
      ],
      "value": {
        "Music": {
          "path": "audio/A-Legend-Ian-Aisling-stream-preview.mp3",
          "playing": true
        },
        "Ambience": {
          "path": "audio/Wind-Ambience-Distant-City-stream-preview.mp3",
          "playing": true
        }
      }
    },
    {
      "kind": "field",
      "first": "inside",
      "path": [
        "audio"
      ],
      "value": {
        "Music": {
          "path": "audio/music/ambient.ogg",
          "playing": true
        }
      }
    },
    {
      "kind": "field",
      "first": "returned",
      "path": [
        "audio"
      ],
      "value": {
        "Music": {
          "path": "audio/A-Legend-Ian-Aisling-stream-preview.mp3",
          "playing": true
        },
        "Ambience": {
          "path": "audio/Wind-Ambience-Distant-City-stream-preview.mp3",
          "playing": true
        }
      }
    },
    {
      "kind": "field",
      "first": "inside",
      "path": [
        "room"
      ],
      "value": "small_room"
    },
    {
      "kind": "field",
      "first": "returned",
      "path": [
        "room"
      ],
      "value": "demo"
    }
  ]
}
