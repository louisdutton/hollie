{
  "name": "two-player analog input and replay",
  "steps": [
    {"command": {"op": "reset", "room": "demo", "players": 2, "seed": 84}, "save_as": "initial"},
    {"command": {"op": "step", "frames": 30, "gamepads": [{"player": "Player_1", "axes": [0, 1]}, {"player": "Player_2", "axes": [0, 0.5]}]}, "save_as": "moved", "capture": "moved.png"},
    {"command": {"op": "step", "frames": 1, "gamepads": [{"player": "Player_1", "axes": [0, 2]}]}, "expect_error": "invalid input state"},
    {"command": {"op": "observe"}, "save_as": "after_error"},
    {"command": {"op": "reset", "room": "demo", "players": 2, "seed": 84}, "save_as": "reset"},
    {"command": {"op": "step", "frames": 30, "gamepads": [{"player": "Player_1", "axes": [0, 1]}, {"player": "Player_2", "axes": [0, 0.5]}]}, "save_as": "replayed", "capture": "replayed.png"}
  ],
  "assertions": [
    {"kind": "equal_state", "first": "initial", "second": "reset"},
    {"kind": "equal_state", "first": "moved", "second": "after_error"},
    {"kind": "equal_state", "first": "moved", "second": "replayed"},
    {"kind": "player_moved", "first": "initial", "second": "moved", "player": 0},
    {"kind": "player_moved", "first": "initial", "second": "moved", "player": 1},
    {"kind": "frame_delta", "first": "initial", "second": "moved", "frames": 30}
  ],
  "image_assertions": [{"first": "moved.png", "second": "replayed.png"}]
}
